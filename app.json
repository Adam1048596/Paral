{
  "expo": {
    "name": "Paral",
    "slug": "Paral",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/logo_icon&text_dark.png",
    "scheme": "paral",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/logo/logo_icon&text_dark.png",
        "backgroundImage": "./assets/logo/logo_icon&text_dark.png",
        "monochromeImage": "./assets/logo/logo_icon&text_dark.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nasr1048596.Paral"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/logo_icon&text_dark.png",
          "imageWidth": 130,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e3092d6-78a6-4c1d-9e5b-70bbfead1559"
      }
    }
  }
}
